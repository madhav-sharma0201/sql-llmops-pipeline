# ──────────────────────────────────────────────────────────────────────────────
# 2-inference-api / .env.example
# Copy this file to .env and fill in your values.  Never commit the real .env!
# ──────────────────────────────────────────────────────────────────────────────

# ── Model ─────────────────────────────────────────────────────────────────────

# Path or Hugging Face repo ID for the fine-tuned adapter weights.
# Examples:
#   ./adapter_weights          ← local directory produced by train_qlora.py
#   madhav/sql-llama-3.2-3b   ← uploaded HF Hub repo
MODEL_PATH=./adapter_weights

# The original base model that the adapter was trained on.
BASE_MODEL=unsloth/Llama-3.2-3B-Instruct

# Human-readable version tag returned by /health and /v1/generate-sql
MODEL_VERSION=v1.0.0

# ── Inference ──────────────────────────────────────────────────────────────────

# Sampling temperature (0 = greedy / deterministic)
TEMPERATURE=0.0

# Maximum new tokens the model is allowed to generate
MAX_NEW_TOKENS=256

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Uvicorn / FastAPI server listens on
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ── Secrets (if you push adapter weights to HF Hub) ──────────────────────────

# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
