# Byte-compiled / optimised Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
.venv310/
venv/
env/
ENV/

# ── Training artefacts ───────────────────────────────────────────────────────
