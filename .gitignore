3-infrastructure/terraform/*.tfstate.backup
3-infrastructure/terraform/*.tfplan
3-infrastructure/terraform/crash.log
3-infrastructure/terraform/override.tf
3-infrastructure/terraform/override.tf.json
3-infrastructure/terraform/*_override.tf
3-infrastructure/terraform/*_override.tf.json
3-infrastructure/terraform/.terraform.lock.hcl

